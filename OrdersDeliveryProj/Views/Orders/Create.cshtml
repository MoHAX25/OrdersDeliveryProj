@model CreateOrderViewModel

@{
    ViewData["Title"] = "Создание нового заказа";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0">Создать новый заказ на доставку</h3>
                </div>
                <div class="card-body">
                    <form asp-action="Create" asp-controller="Orders" method="post" novalidate>
                        @Html.AntiForgeryToken()

                        <fieldset>
                            <legend class="text-muted mb-3">
                                <small><strong>Информация об отправителе</strong></small>
                            </legend>

                            <div class="mb-3">
                                <label asp-for="SenderCity" class="form-label"></label>
                                <input asp-for="SenderCity" class="form-control" placeholder="Введите город отправителя" />
                                <span asp-validation-for="SenderCity" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="SenderAddress" class="form-label"></label>
                                <input asp-for="SenderAddress" class="form-control" placeholder="Введите адрес отправителя" />
                                <span asp-validation-for="SenderAddress" class="text-danger"></span>
                            </div>
                        </fieldset>

                        <fieldset>
                            <legend class="text-muted mb-3">
                                <small><strong>Информация о получателе</strong></small>
                            </legend>

                            <div class="mb-3">
                                <label asp-for="RecipientCity" class="form-label"></label>
                                <input asp-for="RecipientCity" class="form-control" placeholder="Введите город получателя" />
                                <span asp-validation-for="RecipientCity" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="RecipientAddress" class="form-label"></label>
                                <input asp-for="RecipientAddress" class="form-control" placeholder="Введите адрес получателя" />
                                <span asp-validation-for="RecipientAddress" class="text-danger"></span>
                            </div>
                        </fieldset>

                        <fieldset>
                            <legend class="text-muted mb-3">
                                <small><strong>Информация о грузе</strong></small>
                            </legend>

                            <div class="mb-3">
                                <label asp-for="Weight" class="form-label"></label>
                                <div class="input-group">
                                    <input asp-for="Weight" class="form-control" placeholder="Введите вес груза" step="0.1" />
                                    <span class="input-group-text">кг</span>
                                </div>
                                <span asp-validation-for="Weight" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="PickupDate" class="form-label"></label>
                                <input asp-for="PickupDate" type="datetime-local" class="form-control" value="@Model?.PickupDate.ToString("yyyy-MM-ddTHH:mm")" />
                                <span asp-validation-for="PickupDate" class="text-danger"></span>
                            </div>
                        </fieldset>

                        <div class="d-flex gap-2 mt-4">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-circle"></i> Создать заказ
                            </button>
                            <a href="@Url.Action("List", "Orders")" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Назад к списку
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
