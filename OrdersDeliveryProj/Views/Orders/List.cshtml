@model IEnumerable<OrderListViewModel>

@{
    ViewData["Title"] = "Список заказов";
}

<div class="container mt-5">
    <div class="row mb-4">
        <div class="col-md-8">
            <h2>Список всех заказов на доставку</h2>
        </div>
        <div class="col-md-4 text-end">
            <a href="@Url.Action("Create", "Orders")" class="btn btn-success">
                <i class="bi bi-plus-circle"></i> Создать новый заказ
            </a>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Номер заказа</th>
                        <th>Город отправителя</th>
                        <th>Город получателя</th>
                        <th>Вес (кг)</th>
                        <th>Дата забора</th>
                        <th>Дата создания</th>
                        <th>Действие</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model)
                    {
                        <tr style="cursor: pointer;">
                            <td><strong>@order.OrderNumber</strong></td>
                            <td>@order.SenderCity</td>
                            <td>@order.RecipientCity</td>
                            <td>@order.Weight</td>
                            <td>@order.PickupDate.ToString("dd.MM.yyyy HH:mm")</td>
                            <td>@order.CreatedDate.ToString("dd.MM.yyyy HH:mm")</td>
                            <td>
                                <a href="@Url.Action("Details", "Orders", new { id = order.Id })" 
                                   class="btn btn-sm btn-info text-white">
                                    <i class="bi bi-eye"></i> Просмотр
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info" role="alert">
            <i class="bi bi-info-circle"></i> <strong>Нет заказов</strong>
            <p>На данный момент заказы не созданы. 
            <a href="@Url.Action("Create", "Orders")">Создайте первый заказ</a></p>
        </div>
    }
</div>

<style>
    tbody tr:hover {
        background-color: #f5f5f5 !important;
    }
</style>
